# Example environment for FrontendWebApplication

# Preferred API base (full URL or path)
REACT_APP_API_BASE=https://api.example.com/api/v1
# Alternatively:
# REACT_APP_BACKEND_URL=https://api.example.com

# Optional: Force a versioned path regardless of origin/path in API base
# REACT_APP_API_VERSIONED_PATH=/api/v1

# Enable no-backend preview: serve all requests from in-app mocks
REACT_APP_USE_MOCK_API=true

# Other container envs potentially used by deployment (not required locally)
# REACT_APP_FRONTEND_URL=http://localhost:3000
# REACT_APP_WS_URL=ws://localhost:3001
# REACT_APP_NODE_ENV=development
# REACT_APP_ENABLE_SOURCE_MAPS=true
# REACT_APP_PORT=3000
# REACT_APP_TRUST_PROXY=false
# REACT_APP_LOG_LEVEL=info
# REACT_APP_HEALTHCHECK_PATH=/health
# REACT_APP_FEATURE_FLAGS=
# REACT_APP_EXPERIMENTS_ENABLED=false
